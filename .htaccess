# ============================================================================
# ET Transport — production hardening
# ----------------------------------------------------------------------------
# Central hardening applied by Apache (mod_headers, mod_authz_core) and
# mod_php. Everything here is an additive, deployment-level security layer and
# does NOT change any application business logic.
#
# Confirmed safe for this project:
#   - all scripts are local same-origin files (no external CDNs/fonts)
#   - there are NO inline <script> blocks and NO inline event-handler
#     attributes (onclick= etc.) anywhere in the HTML or injected via
#     innerHTML, so `script-src 'self'` does not break the UI
#   - inline <style>/style= attributes ARE used, so style-src keeps
#     'unsafe-inline'
#   - data: URIs are used for a few inline SVG images -> img-src allows data:
#   - no iframe/object/embed/<use> is used -> object-src 'none' is safe
#   - XHR/fetch all target the same origin (api/...) -> connect-src 'self'
# ============================================================================

# ---- No version disclosure in response headers ------------------------------
Header unset X-Powered-By

# ---- Directory listing disabled ------------------------------------------------
# If a directory has no index file, Apache returns a listing of its contents
# unless this option is disabled. Asset directories are NOT auto-generated
# index pages, so this must be off in production.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ---- Basic production security headers --------------------------------------
# MIME sniffing off.
Header always set X-Content-Type-Options "nosniff"

# Referrer-Policy: never leak the full URL to other origins.
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Clickjacking protection (no frames are used anywhere in the app).
Header always set X-Frame-Options "DENY"

# Permissions-Policy: deny geolocation/camera/mic/USB from the web app.
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"

# Content-Security-Policy — see the audit note above. Kept broad enough to not
# break the existing inline-style UI, strict enough to block injected script.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

# ---- Production error containment (mod_php) ----------------------------------
# The dev php.ini ships display_errors=On. This keeps warnings/fatals OUT of the
# HTTP response for the app (they still go to the server error log). It mirrors
# the existing API error handling that already returns generic JSON.
<IfModule php_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>

# ---- Block web access to non-served directories ------------------------------
# config/, database/, scripts/ and scheduler/ are NEVER meant to be reachable
# over HTTP here: they are included server-side (require_once) or run from the
# CLI. Blocking them prevents path/configuration disclosure and prevents the
# database seed scripts (dev credentials) from being triggered through a
# browser. (Server-side includes are unaffected by this.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|database|scripts|scheduler)(/|$) - [F,L]
</IfModule>
